# Copiar a .env (nunca versionar .env). Sin credenciales: STORE_BACKEND=memory y LLM_MODE=fake.

# --- LLM: GPT-6 Luna vía OpenRouter ---
OPENROUTER_API_KEY=
# Slug de GPT-6 Luna en OpenRouter; confirmar el nombre exacto en openrouter.ai/models
LLM_MODEL=
# real | fake
LLM_MODE=fake

# --- Persistencia ---
# supabase | memory
STORE_BACKEND=memory
SUPABASE_URL=https://shjpypqcetndpokklycy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa (puede ser solo IPv6); si falla, usar la cadena del Session pooler del panel.
DATABASE_URL=postgresql://postgres:<CONTRASEÑA>@db.shjpypqcetndpokklycy.supabase.co:5432/postgres

# --- API ---
# Orígenes permitidos, separados por coma; añadir la URL de Vercel
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Opcionales ---
# DATA_DIR=./data
# REPLAYS_DIR=./replays
# 2.0 = el doble de rápido
# REPLAY_VELOCIDAD=1.0
# Espera máxima entre eventos del replay, en segundos
# REPLAY_MAX_ESPERA_S=2.0
# RUN_TIMEOUT_S=120
# Tiempo máximo por llamada a Supabase, en segundos; al superarlo el backend sigue en memoria
# SUPABASE_TIMEOUT_S=5
